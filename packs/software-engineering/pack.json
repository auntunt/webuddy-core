{
  "name": "software-engineering",
  "version": "0.1.0",
  "engine": ">=1.0",
  "title": "软件工程八步法",
  "description": "软件工程八步法验收包",
  "industry": "software",
  "native": true,
  "lexicons": {
    "boundary": ["为空", "超长", "重复", "并发", "非法", "越权", "断网", "重试"]
  },
  "hints": {
    "testFile": "(^|[/._-])(test|tests|spec|__tests__|e2e)([/._-]|$)",
    "schemaFile": "(schema\\.prisma|migrations?/|\\.sql$|models?\\.(py|ts|js)$)",
    "caseMark": "(^|[^\\w.])(test|it|describe)\\s*(\\.\\s*\\w+\\s*)?\\(",
    "assertMark": "(^|[^\\w.])(assert|expect|should)\\s*(\\.\\s*\\w+\\s*)?\\(",
    "depsFile": "package.json",
    "depsPaths": ["dependencies", "devDependencies"],
    "testCmd": "(^|[\\s;&|])(npm|pnpm|yarn|bun)\\s+(run\\s+)?(test|test:unit|vitest|jest)\\b|(^|[\\s;&|])(vitest|jest|pytest|go\\s+test|cargo\\s+test|mvn\\s+test|phpunit)\\b",
    "startCmd": "(^|[\\s;&|])(npm|pnpm|yarn|bun)\\s+(run\\s+)?(dev|start|serve)\\b",
    "rootMarks": [".git", "package.json", "pyproject.toml", "go.mod", "Cargo.toml"]
  },
  "hooks": {
    "dependentGates": ["5.2", "5.3", "5.4", "5.5", "5.7", "5.8"]
  }
}
